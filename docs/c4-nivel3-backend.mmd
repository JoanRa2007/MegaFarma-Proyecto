title Nivel 3 - Componentes del servicio REST (megafarma-backend)
Container_Boundary(api, "Servicio REST (Spring Boot 4)") {
  Component(filtro, "Filtro de Seguridad JWT", "Spring Security", "Valida token JWT, emisor, revocacion y rate-limit")
  Component(ctrl, "Controladores REST", "Spring Web (@RestController)", "Exponen /api/v1/* y validan DTOs")
  Component(serv, "Servicios de Negocio", "Spring @Service", "Reglas de venta, FEFO, reportes y auditoria")
  Component(repo, "Repositorios JPA", "Spring Data JPA", "Consultas parametrizadas hacia PostgreSQL")
